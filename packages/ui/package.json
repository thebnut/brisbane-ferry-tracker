{
  "name": "@bft/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared React 19 design system in the BrisbaneFerry look (round 2): Tailwind 4 tokens, components, formatting helpers, lazy MapView.",
  "exports": {
    ".": "./src/index.ts",
    "./format": "./src/format.ts",
    "./connectivity": "./src/connectivity.ts",
    "./demo": "./src/demo.tsx",
    "./bus": "./src/bus.tsx",
    "./star": "./src/star.tsx",
    "./trip": "./src/trip.tsx",
    "./panel": "./src/panel.tsx",
    "./board-route": "./src/board-route.ts",
    "./alert-count": "./src/AlertCountLink.tsx",
    "./destination-sheet": "./src/DestinationSheet.tsx",
    "./board-header": "./src/board-header.tsx",
    "./save-toast": "./src/SaveToast.tsx",
    "./map": "./src/map/MapView.tsx",
    "./safe-map": "./src/map/SafeMap.tsx",
    "./stop-picker": "./src/stop-picker.ts",
    "./stop-picker-map": "./src/StopPickerMap.tsx",
    "./onboarding": "./src/onboarding.ts",
    "./onboarding-prompt": "./src/OnboardingPrompt.tsx",
    "./onboarding-picker": "./src/OnboardingPicker.tsx",
    "./onboarding-rerun": "./src/OnboardingRerun.tsx",
    "./map-toggle": "./src/MapToggle.tsx",
    "./stop-search": "./src/StopSearch.tsx",
    "./theme.css": "./src/theme.css",
    "./assets/*": "./assets/*",
    "./sw": "./src/sw.ts",
    "./upstream": "./src/upstream.ts",
    "./whats-new": "./src/WhatsNew.tsx",
    "./redirect": "./src/redirect.ts",
    "./handoff-codec": "./src/handoff-codec.ts",
    "./e2e/*": "./e2e/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.3",
    "maplibre-gl": "6.14.0",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "devDependencies": {
    "@bft/config": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}

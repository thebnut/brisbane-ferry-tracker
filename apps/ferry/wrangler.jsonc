{
  "$schema": "node_modules/wrangler/config-schema.json",
  // BrisbaneFerry SSR Worker (React Router 8 framework mode). Static files in build/client are served by Workers
  // static assets before the Worker runs, so they are free and unmetered.
  "name": "bft-ferry",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "dde2914802079766f7671528e7cbae75",
  "workers_dev": true,
  "observability": { "enabled": true },
  // drop-trailing-slash: prerendered /privacy/index.html is served at /privacy (no redirect), like the live site.
  "assets": { "directory": "./build/client", "binding": "ASSETS", "html_handling": "drop-trailing-slash" },
  "vars": {
    // HTTP fallback when the API service binding is absent (local dev, previews).
    "API_BASE": "https://bft-api.brisbanetransit.workers.dev",
    // "1" lets visitors switch on fixture mode with ?fixtures=1. Never set in production.
    "ALLOW_FIXTURES": "1",
    // "1" serves fixture data to everyone (dev and Playwright without the live API).
    "FIXTURES": "0",
    "SITE_URL": "https://www.brisbaneferry.com"
  },
  "env": {
    "staging": {
      "name": "bft-ferry",
      "workers_dev": true,
      "vars": {
        "API_BASE": "https://bft-api.brisbanetransit.workers.dev",
        "ALLOW_FIXTURES": "1",
        "FIXTURES": "0",
        // Until bft-api has ferry data: answer with fixture data (and say so on the page) when the API errors.
        "FIXTURE_FALLBACK": "1",
        "SITE_URL": "https://www.brisbaneferry.com"
      },
      // The SSR loader and the /v1 proxy call the API Worker in-process through this binding.
      "services": [{ "binding": "API", "service": "bft-api" }]
    },
    // PRODUCTION: first on the preview host next.brisbaneferry.com; brisbaneferry.com and www move here only at the
    // DNS cutover step of docs/architecture/cutover-runbook.md (Vercel keeps serving until then). Deployed from main.
    "production": {
      "name": "bft-ferry-prod",
      "workers_dev": false,
      "routes": [{ "pattern": "next.brisbaneferry.com", "custom_domain": true }],
      "vars": {
        "API_BASE": "https://api.brisbaneferry.com",
        "ALLOW_FIXTURES": "0",
        "FIXTURES": "0",
        "SITE_URL": "https://www.brisbaneferry.com"
      },
      "services": [{ "binding": "API", "service": "bft-api-prod" }]
    }
  }
}

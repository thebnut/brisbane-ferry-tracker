{
  "$schema": "node_modules/wrangler/config-schema.json",
  // BrisbaneBus SSR Worker (React Router 8 framework mode). Static files in build/client (JS, CSS, icons and the
  // static client data under /data/bus/ when `pnpm data` has built it) are served by Workers static assets before
  // the Worker runs, so they are free and unmetered.
  "name": "bft-bus",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "dde2914802079766f7671528e7cbae75",
  "workers_dev": true,
  "observability": { "enabled": true },
  // drop-trailing-slash: prerendered /about/index.html is served at /about (no redirect).
  "assets": { "directory": "./build/client", "binding": "ASSETS", "html_handling": "drop-trailing-slash" },
  "vars": {
    // HTTP fallback when the API service binding is absent (local dev, previews).
    "API_BASE": "https://bft-api.brisbanetransit.workers.dev",
    // "1" lets visitors switch on fixture mode with ?fixtures=1. Never set in production.
    "ALLOW_FIXTURES": "1",
    // "1" serves fixture data to everyone (dev and Playwright without the live API).
    "FIXTURES": "0",
    "SITE_URL": "https://bft-bus.brisbanetransit.workers.dev"
  },
  "env": {
    "staging": {
      "name": "bft-bus",
      "workers_dev": true,
      "vars": {
        "API_BASE": "https://bft-api.brisbanetransit.workers.dev",
        "ALLOW_FIXTURES": "1",
        "FIXTURES": "0",
        // Until bft-api has bus data: answer with fixture data (the pages say "Demo data") when the API errors.
        "FIXTURE_FALLBACK": "1",
        "SITE_URL": "https://bft-bus.brisbanetransit.workers.dev"
      },
      // SSR loaders and the /v1 + /data proxy call the API Worker in-process through this binding.
      "services": [{ "binding": "API", "service": "bft-api" }]
    }
  }
}

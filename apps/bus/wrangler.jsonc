{
  "$schema": "node_modules/wrangler/config-schema.json",
  // BrisbaneBus SSR Worker (React Router 8 framework mode). Static files in build/client (JS, CSS, icons and the
  // static client data under /data/bus/ when `pnpm data` has built it) are served by Workers static assets before
  // the Worker runs, so they are free and unmetered.
  "name": "bft-bus",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "dde2914802079766f7671528e7cbae75",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": { "directory": "./build/client", "binding": "ASSETS" },
  "vars": {
    // HTTP fallback when the API service binding is absent (local dev, previews).
    "API_BASE": "https://bft-api.brisbanetransit.workers.dev",
    // "1" lets visitors switch on fixture mode with ?fixtures=1. Never set in production.
    "ALLOW_FIXTURES": "1",
    // "1" serves fixture data to everyone (dev and Playwright without the live API).
    "FIXTURES": "0",
    "SITE_URL": "https://bft-bus.brisbanetransit.workers.dev"
  },
  "env": {
    "staging": {
      "name": "bft-bus",
      "workers_dev": true,
      "vars": {
        "API_BASE": "https://bft-api.brisbanetransit.workers.dev",
        "ALLOW_FIXTURES": "1",
        "FIXTURES": "0",
        // Until bft-api has bus data: answer with fixture data (the pages say "Demo data") when the API errors.
        "FIXTURE_FALLBACK": "1",
        "SITE_URL": "https://bft-bus.brisbanetransit.workers.dev"
      },
      // SSR loaders and the /v1 + /data proxy call the API Worker in-process through this binding.
      "services": [{ "binding": "API", "service": "bft-api" }]
    },
    // PRODUCTION, step 8.1 (docs/architecture/cutover-runbook.md "Train, bus and transit production"): the same
    // Worker on its workers.dev host only (bft-bus-prod.brisbanetransit.workers.dev), no custom domains, so it can
    // be checked before any DNS record changes. Keep it identical to "production" except workers_dev and routes
    // (test/wrangler-config.test.ts checks this). Deployed from main.
    "production-preview": {
      "name": "bft-bus-prod",
      "workers_dev": true,
      "vars": {
        "API_BASE": "https://api.brisbaneferry.com",
        "ALLOW_FIXTURES": "0",
        "FIXTURES": "0",
        // No FIXTURE_FALLBACK: production never serves demo data.
        "SITE_URL": "https://brisbanebus.com",
        // Soft launch: noindex + robots Disallow until the real domain is verified, then "1" (runbook 8.5).
        "INDEXABLE": "0"
      },
      "services": [{ "binding": "API", "service": "bft-api-prod" }]
    },
    // PRODUCTION on brisbanebus.com + www (www 301s to the apex in the Worker). Both hostnames already have DNS records:
    // deploy this only after Brett has exported and approved replacing them (runbook 8.3–8.4). Deployed from main.
    "production": {
      "name": "bft-bus-prod",
      "workers_dev": false,
      "routes": [
        { "pattern": "brisbanebus.com", "custom_domain": true },
        { "pattern": "www.brisbanebus.com", "custom_domain": true }
      ],
      "vars": {
        "API_BASE": "https://api.brisbaneferry.com",
        "ALLOW_FIXTURES": "0",
        "FIXTURES": "0",
        // No FIXTURE_FALLBACK: production never serves demo data.
        "SITE_URL": "https://brisbanebus.com",
        // Soft launch: noindex + robots Disallow until the real domain is verified, then "1" (runbook 8.5).
        "INDEXABLE": "0"
      },
      "services": [{ "binding": "API", "service": "bft-api-prod" }]
    }
  }
}

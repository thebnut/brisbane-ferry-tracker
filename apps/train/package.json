{
  "name": "@bft/train",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BrisbaneTrain on the transit platform: React Router 8 framework mode (SSR station pages) on Cloudflare Workers.",
  "exports": {
    "./app/*": "./app/*"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "pnpm build && wrangler dev",
    "typecheck": "react-router typegen && tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data": "tsx scripts/build-data.ts",
    "deploy:staging": "CLOUDFLARE_ENV=staging pnpm build && wrangler deploy",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@bft/core": "workspace:*",
    "@bft/ui": "workspace:*",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/status-bar": "8.0.4",
    "@leeoniya/ufuzzy": "1.0.19",
    "@tanstack/react-query": "5.104.4",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bft/config": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@capacitor/cli": "8.5.3",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261018.1",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1",
    "wrangler": "4.151.1"
  }
}

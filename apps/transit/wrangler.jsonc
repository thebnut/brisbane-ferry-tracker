{
  "$schema": "node_modules/wrangler/config-schema.json",
  // BrisbaneTransit SSR Worker (React Router 8 framework mode): the Mode Tabs shell. Static files in build/client are
  // served by Workers static assets before the Worker runs.
  "name": "bft-transit",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "account_id": "dde2914802079766f7671528e7cbae75",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": { "directory": "./build/client", "binding": "ASSETS" },
  // /api/feedback per-IP limiter (workers/legacy.ts), keyed by CF-Connecting-IP. Simple periods are 10 or 60 s only,
  // so "about 3 per 10 minutes" becomes 3 per 60 s: enough for a retry, while a flood is cut to 3/min per IP.
  // Counters are per Cloudflare location and eventually consistent. Bindings aren't inherited, so every env sets
  // its own, and each namespace_id is unique in the account (8001/8002 belong to services/edge).
  "ratelimits": [
    { "name": "FEEDBACK_LIMITER", "namespace_id": "8104", "simple": { "limit": 3, "period": 60 } }
  ],
  "vars": {
    // HTTP fallback when the API service binding is absent (local dev, previews).
    "API_BASE": "https://bft-api.brisbanetransit.workers.dev",
    // "1" lets visitors switch on fixture mode with ?fixtures=1. Never set in production.
    "ALLOW_FIXTURES": "1",
    // "1" serves fixture data to everyone (dev and Playwright without the live API).
    "FIXTURES": "0",
    "SITE_URL": "https://bft-transit.brisbanetransit.workers.dev",
    // No FERRY/TRAIN/BUS_SITE_URL: the mounted mode pages' canonical URLs are this site's own (SITE_URL + /ferry etc.),
    // since the mode hosts redirect here once REDIRECT_TO_TRANSIT is on (P6). Production does the same since release 24.
    // Invisible Turnstile widget for the Ask box and the feedback sheet: the STAGING widget "bft-transit-ask" (public
    // sitekey; its secret lives on bft-api). Both production envs use the PROD widget (test/wrangler-config.test.ts).
    "TURNSTILE_SITEKEY": "0x4AAAAAAFZ6yPZTYH3xrIMT"
  },
  "env": {
    "staging": {
      "name": "bft-transit",
      "workers_dev": true,
      "vars": {
        // GA4 (@bft/ui/analytics-config): one property for the four sites. Unset locally and in tests (GA off).
        "GA_MEASUREMENT_ID": "G-MEG3CX0SFC",
        // debug_mode on staging, so DebugView shows the visits (filter staging out by hostname).
        "GA_DEBUG": "1",
        "API_BASE": "https://bft-api.brisbanetransit.workers.dev",
        "ALLOW_FIXTURES": "1",
        "FIXTURES": "0",
        // Canonicals, og:url, the sitemap and llms.txt name the production URLs, as production-preview's do: this host is
        // never indexable (robots.txt disallows all, X-Robots-Tag and a robots meta say noindex), and a canonical to
        // workers.dev would point search engines at it. Redirects never use it here (www and the https upgrade match only
        // SITE_URL's own host).
        "SITE_URL": "https://brisbanetransit.com",
        "TURNSTILE_SITEKEY": "0x4AAAAAAFZ6yPZTYH3xrIMT"
      },
      // SSR loaders, the /v1 + /data proxy and POST /v1/ask call the API Worker in-process through this binding.
      "services": [{ "binding": "API", "service": "bft-api" }],
      "ratelimits": [
        { "name": "FEEDBACK_LIMITER", "namespace_id": "8105", "simple": { "limit": 3, "period": 60 } }
      ]
    },
    // PRODUCTION, step 8.1 (docs/architecture/cutover-runbook.md "Train, bus and transit production"): the same
    // Worker on its workers.dev host only (bft-transit-prod.brisbanetransit.workers.dev), no custom domains, so it can
    // be checked before any DNS record changes. Keep it identical to "production" except workers_dev and routes
    // (test/wrangler-config.test.ts checks this). Deployed from main.
    "production-preview": {
      "name": "bft-transit-prod",
      "workers_dev": true,
      "vars": {
        // GA4 as production (this is the production Worker on workers.dev): a preview deploy must not switch it off.
        "GA_MEASUREMENT_ID": "G-MEG3CX0SFC",
        "API_BASE": "https://api.brisbaneferry.com",
        "ALLOW_FIXTURES": "0",
        "FIXTURES": "0",
        "SITE_URL": "https://brisbanetransit.com",
        // No FERRY/TRAIN/BUS_SITE_URL: the mounted mode pages are canonical here (release 24). This host is workers.dev:
        // it stays noindex, unlike "production" (test/wrangler-config.test.ts allows only that difference).
        "INDEXABLE": "0",
        // The PROD widget "bft-transit-prod" (bft-api-prod holds its secret). Its hostnames don't include the
        // production-preview host, so Turnstile-gated features fail closed there by design (runbook section 9).
        "TURNSTILE_SITEKEY": "0x4AAAAAAFan8LE5_4cvR40S"
      },
      // POST /v1/ask reaches bft-api-prod, where AI_ENABLED=false: deterministic answers or a "Try: …" hint only.
      "services": [{ "binding": "API", "service": "bft-api-prod" }],
      // Secret (not here): FEEDBACK_DISCORD_WEBHOOK_URL (wrangler secret put --name bft-transit-prod). Every env has its
      // own limiter namespace (apps/transit/test/feedback.test.ts), so this one differs from production's.
      "ratelimits": [
        { "name": "FEEDBACK_LIMITER", "namespace_id": "8107", "simple": { "limit": 3, "period": 60 } }
      ]
    },
    // PRODUCTION on brisbanetransit.com + www (www 301s to the apex in the Worker). Both hostnames already have DNS records:
    // deploy this only after Brett has exported and approved replacing them (runbook 8.3–8.4). Deployed from main.
    "production": {
      "name": "bft-transit-prod",
      "workers_dev": false,
      "routes": [
        { "pattern": "brisbanetransit.com", "custom_domain": true },
        { "pattern": "www.brisbanetransit.com", "custom_domain": true }
      ],
      "vars": {
        // GA4 (@bft/ui/analytics-config): one property for the four sites. Unset locally and in tests (GA off).
        "GA_MEASUREMENT_ID": "G-MEG3CX0SFC",
        "API_BASE": "https://api.brisbaneferry.com",
        "ALLOW_FIXTURES": "0",
        "FIXTURES": "0",
        "SITE_URL": "https://brisbanetransit.com",
        // No FERRY/TRAIN/BUS_SITE_URL: the mounted mode pages are canonical here, under /ferry, /train and /bus, and
        // the old mode hosts 301 to them (release 24). "1": no X-Robots-Tag, robots.txt allows crawling and names
        // /sitemap.xml. Pages that shouldn't be in search (My Transit, Nearby, trips, Alerts, What's new) say noindex.
        "INDEXABLE": "1",
        // The PROD widget "bft-transit-prod" (bft-api-prod holds its secret). Its hostnames don't include the
        // production-preview host, so Turnstile-gated features fail closed there by design (runbook section 9).
        "TURNSTILE_SITEKEY": "0x4AAAAAAFan8LE5_4cvR40S"
      },
      // POST /v1/ask reaches bft-api-prod, where AI_ENABLED=false: deterministic answers or a "Try: …" hint only.
      "services": [{ "binding": "API", "service": "bft-api-prod" }],
      // Secret (not here): FEEDBACK_DISCORD_WEBHOOK_URL (wrangler secret put --name bft-transit-prod). Every env has its
      // own limiter namespace (apps/transit/test/feedback.test.ts).
      "ratelimits": [
        { "name": "FEEDBACK_LIMITER", "namespace_id": "8106", "simple": { "limit": 3, "period": 60 } }
      ]
    }
  }
}

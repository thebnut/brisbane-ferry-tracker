{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "packages/**",
      "apps/**",
      "services/**",
      "pipeline/**",
      "!**/dist",
      "!pipeline/.tmp",
      "!pipeline/out",
      "!**/build",
      "!**/__golden__",
      "!**/node_modules",
      "!**/.wrangler",
      "!**/fixtures/**/*.json",
      "!**/.react-router",
      "!**/assets/**/*.svg",
      "!**/public/**/*.svg",
      "!apps/train/app/data/*.json",
      "!apps/train/public/data",
      "!**/test-results",
      "!**/playwright-report",
      "!**/public/data"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}

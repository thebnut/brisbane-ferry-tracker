{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "functions": {
    "api/gtfs-proxy.js": {
      "maxDuration": 10
    },
    "api/feedback.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {"source": "/privacy.html", "has": [{"type": "host", "value": "^(?:www\\.)?brisbaneferry\\.com$"}], "destination": "https://brisbanetransit.com/ferry/privacy", "statusCode": 301},
    {"source": "/terms.html", "has": [{"type": "host", "value": "^(?:www\\.)?brisbaneferry\\.com$"}], "destination": "https://brisbanetransit.com/ferry/terms", "statusCode": 301},
    {"source": "/sitemap.xml", "has": [{"type": "host", "value": "^(?:www\\.)?brisbaneferry\\.com$"}], "destination": "https://brisbanetransit.com/sitemap.xml", "statusCode": 301},
    {"source": "/robots.txt", "has": [{"type": "host", "value": "^(?:www\\.)?brisbaneferry\\.com$"}], "destination": "https://brisbanetransit.com/robots.txt", "statusCode": 301},
    {"source": "/terminal/:slug/index.html", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}, {"type": "cookie", "key": "bft-handoff", "value": "1"}], "destination": "https://brisbanetransit.com/ferry/terminal/:slug", "statusCode": 301},
    {"source": "/terminal/:slug/index.html", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}], "missing": [{"type": "header", "key": "sec-fetch-mode"}], "destination": "https://brisbanetransit.com/ferry/terminal/:slug", "statusCode": 301},
    {"source": "/terminal/:slug/index.html", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}, {"type": "header", "key": "user-agent", "value": ".*(?:[Bb]ot|[Cc]rawler|[Ss]pider|[Ss]lurp|facebookexternalhit|WhatsApp|Yandex).*"}], "destination": "https://brisbanetransit.com/ferry/terminal/:slug", "statusCode": 301},
    {"source": "/terminal/:slug/index.html", "has": [{"type": "host", "value": "^brisbaneferry\\.com$"}], "destination": "https://brisbanetransit.com/ferry/terminal/:slug", "statusCode": 301},
    {"source": "/terminal/:slug/", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}, {"type": "cookie", "key": "bft-handoff", "value": "1"}], "destination": "https://brisbanetransit.com/ferry/terminal/:slug", "statusCode": 301},
    {"source": "/terminal/:slug/", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}], "missing": [{"type": "header", "key": "sec-fetch-mode"}], "destination": "https://brisbanetransit.com/ferry/terminal/:slug", "statusCode": 301},
    {"source": "/terminal/:slug/", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}, {"type": "header", "key": "user-agent", "value": ".*(?:[Bb]ot|[Cc]rawler|[Ss]pider|[Ss]lurp|facebookexternalhit|WhatsApp|Yandex).*"}], "destination": "https://brisbanetransit.com/ferry/terminal/:slug", "statusCode": 301},
    {"source": "/terminal/:slug/", "has": [{"type": "host", "value": "^brisbaneferry\\.com$"}], "destination": "https://brisbanetransit.com/ferry/terminal/:slug", "statusCode": 301},
    {"source": "/terminal/:slug", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}, {"type": "cookie", "key": "bft-handoff", "value": "1"}], "destination": "https://brisbanetransit.com/ferry/terminal/:slug", "statusCode": 301},
    {"source": "/terminal/:slug", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}], "missing": [{"type": "header", "key": "sec-fetch-mode"}], "destination": "https://brisbanetransit.com/ferry/terminal/:slug", "statusCode": 301},
    {"source": "/terminal/:slug", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}, {"type": "header", "key": "user-agent", "value": ".*(?:[Bb]ot|[Cc]rawler|[Ss]pider|[Ss]lurp|facebookexternalhit|WhatsApp|Yandex).*"}], "destination": "https://brisbanetransit.com/ferry/terminal/:slug", "statusCode": 301},
    {"source": "/terminal/:slug", "has": [{"type": "host", "value": "^brisbaneferry\\.com$"}], "destination": "https://brisbanetransit.com/ferry/terminal/:slug", "statusCode": 301},
    {"source": "/index.html", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}, {"type": "cookie", "key": "bft-handoff", "value": "1"}], "destination": "https://brisbanetransit.com/ferry", "statusCode": 301},
    {"source": "/index.html", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}], "missing": [{"type": "header", "key": "sec-fetch-mode"}], "destination": "https://brisbanetransit.com/ferry", "statusCode": 301},
    {"source": "/index.html", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}, {"type": "header", "key": "user-agent", "value": ".*(?:[Bb]ot|[Cc]rawler|[Ss]pider|[Ss]lurp|facebookexternalhit|WhatsApp|Yandex).*"}], "destination": "https://brisbanetransit.com/ferry", "statusCode": 301},
    {"source": "/index.html", "has": [{"type": "host", "value": "^brisbaneferry\\.com$"}], "destination": "https://brisbanetransit.com/ferry", "statusCode": 301},
    {"source": "/", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}, {"type": "cookie", "key": "bft-handoff", "value": "1"}], "destination": "https://brisbanetransit.com/ferry", "statusCode": 301},
    {"source": "/", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}], "missing": [{"type": "header", "key": "sec-fetch-mode"}], "destination": "https://brisbanetransit.com/ferry", "statusCode": 301},
    {"source": "/", "has": [{"type": "host", "value": "^www\\.brisbaneferry\\.com$"}, {"type": "header", "key": "user-agent", "value": ".*(?:[Bb]ot|[Cc]rawler|[Ss]pider|[Ss]lurp|facebookexternalhit|WhatsApp|Yandex).*"}], "destination": "https://brisbanetransit.com/ferry", "statusCode": 301},
    {"source": "/", "has": [{"type": "host", "value": "^brisbaneferry\\.com$"}], "destination": "https://brisbanetransit.com/ferry", "statusCode": 301},
    {"source": "/:path((?!api(?:/|$)|handoff-ferry\\.js$|index\\.html$|terminal/[^/]+/?(?:index\\.html)?$|assets/|[^/]+\\.(?:js|css|png|ico|svg|jpe?g|webmanifest|csv)$).+)", "has": [{"type": "host", "value": "^(?:www\\.)?brisbaneferry\\.com$"}], "destination": "https://brisbanetransit.com/ferry/:path*", "statusCode": 301}
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terminal/:slug",
      "destination": "/terminal/:slug/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), payment=(), usb=(), geolocation=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://vercel.live https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org https://tile.openstreetmap.org https://cdnjs.cloudflare.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; font-src 'self' data: https://vercel.live https://assets.vercel.com; connect-src 'self' https://tiles.openfreemap.org https://thebnut.github.io https://bft-api.brisbanetransit.workers.dev https://api.brisbaneferry.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com https://vercel.live wss://vercel.live; worker-src 'self' blob:; frame-src 'self' https://vercel.live https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

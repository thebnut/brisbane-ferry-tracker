// API Worker + RtHub Durable Object (transit-architecture.md §3.3, §3.8, ADR-0003).
// Deploy staging (needs `wrangler login`): `pnpm --filter @bft/edge deploy:staging` → bft-api.brisbanetransit.workers.dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bft-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "dde2914802079766f7671528e7cbae75",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "workers_dev": true,
  "version_metadata": { "binding": "CF_VERSION" },
  // Watchdog: re-arms the RtHub alarm chain if the last good cycle is older than 45 s.
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [{ "name": "RT_HUB", "class_name": "RtHub" }] },
  // Free plan: SQLite-backed Durable Objects only.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RtHub"] }],
  // Local dev reads the assets data Worker (services/data serving ./out). Staging reads R2 (DATA_BUCKET), which
  // takes precedence whenever it is bound; the DATA service binding stays an optional fallback.
  "services": [{ "binding": "DATA", "service": "bft-data-dev" }],
  "vars": {
    "RT_MODES": "ferry,train",
    "RT_UPSTREAM": "https://gtfsrt.api.translink.com.au/api/realtime/SEQ",
    "CORS_ALLOW_ALL": "false"
  },
  "env": {
    // bft-api.brisbanetransit.workers.dev (Workers Free; SQLite-backed DO). No routes or custom domains.
    "staging": {
      "name": "bft-api",
      "workers_dev": true,
      "version_metadata": { "binding": "CF_VERSION" },
      "triggers": { "crons": ["* * * * *"] },
      "durable_objects": { "bindings": [{ "name": "RT_HUB", "class_name": "RtHub" }] },
      "r2_buckets": [{ "binding": "DATA_BUCKET", "bucket_name": "bft-transit-data" }],
      // Intentionally no DATA service binding: staging reads R2. (Wrangler warns that the top-level DATA binding
      // is not inherited; that is the point.)
      "services": [],
      // Workers Paid (active 18 Oct 2026). Measured: a bus-indexed RT_MODES=all poll is ~150 ms p50 / ~250 ms
      // cold; 2 s caps a runaway cycle at ~8x the worst observed while leaving ample headroom.
      "limits": { "cpu_ms": 2000 },
      // Paid sizing: combined feeds (12,960 TransLink requests a day) with every mode matched, bus included (the
      // compact matcher fits two bus days in ~26 MB). The top-level config keeps the Free-safe ferry,train defaults.
      "vars": {
        "RT_MODES": "all",
        "RT_INDEX_MODES": "ferry,train,tram,bus",
        "RT_UPSTREAM": "https://gtfsrt.api.translink.com.au/api/realtime/SEQ",
        "CORS_ALLOW_ALL": "false"
      }
    }
  }
}

// API Worker + RtHub Durable Object (transit-architecture.md §3.3, §3.8, ADR-0003).
// Deploy staging (needs `wrangler login`): `pnpm --filter @bft/edge deploy:staging` → bft-api.brisbanetransit.workers.dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bft-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "account_id": "dde2914802079766f7671528e7cbae75",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "workers_dev": true,
  "version_metadata": { "binding": "CF_VERSION" },
  // Watchdog: re-arms the RtHub alarm chain if the last good cycle is older than 45 s.
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "RT_HUB", "class_name": "RtHub" }, { "name": "BUDGET", "class_name": "Budget" }]
  },
  // Free plan: SQLite-backed Durable Objects only.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RtHub"] },
    { "tag": "v2", "new_sqlite_classes": ["Budget"] }
  ],
  // /v1/ask burst protection only (local, eventually consistent): 3 requests a minute per IP (it can spend LLM tokens).
  // /mcp tools/call: 30 a minute per IP (MCP_LIMITER). It spends no tokens (the caller's model reasons) and reads the
  // same cached /v1 data as the API, so it needs room for an agent's burst of lookups; the handshake (initialize,
  // notifications, ping, tools/list) isn't counted. Ids 8005/8006 are edge's.
  // /v1/turnstile/verify (the feedback relays): a local burst limit of 20 a minute per caller IP (Vercel's egress IPs
  // are shared, and each feedback post is already limited at the relay). The aggregate 300 a minute is counted in the
  // Budget DO (src/ai/verify-window.ts): these binding counters are per location. Ids 8003/8004 are edge's.
  "ratelimits": [
    { "name": "ASK_LIMITER", "namespace_id": "8001", "simple": { "limit": 3, "period": 60 } },
    { "name": "MCP_LIMITER", "namespace_id": "8005", "simple": { "limit": 30, "period": 60 } },
    { "name": "VERIFY_LIMITER", "namespace_id": "8003", "simple": { "limit": 20, "period": 60 } }
  ],
  // Local dev reads the assets data Worker (services/data serving ./out). Staging reads R2 (DATA_BUCKET), which
  // takes precedence whenever it is bound; the DATA service binding stays an optional fallback.
  "services": [{ "binding": "DATA", "service": "bft-data-dev" }],
  "vars": {
    "RT_MODES": "ferry,train",
    "RT_UPSTREAM": "https://gtfsrt.api.translink.com.au/api/realtime/SEQ",
    "CORS_ALLOW_ALL": "false",
    "AI_ENABLED": "false",
    "AI_MONTHLY_BUDGET_USD": "0"
  },
  "env": {
    // bft-api.brisbanetransit.workers.dev (Workers Free; SQLite-backed DO). No routes or custom domains.
    "staging": {
      "name": "bft-api",
      "workers_dev": true,
      "version_metadata": { "binding": "CF_VERSION" },
      "triggers": { "crons": ["* * * * *"] },
      "durable_objects": {
        "bindings": [
          { "name": "RT_HUB", "class_name": "RtHub" },
          { "name": "BUDGET", "class_name": "Budget" }
        ]
      },
      "ratelimits": [
        { "name": "ASK_LIMITER", "namespace_id": "8001", "simple": { "limit": 3, "period": 60 } },
        { "name": "MCP_LIMITER", "namespace_id": "8005", "simple": { "limit": 30, "period": 60 } },
        { "name": "VERIFY_LIMITER", "namespace_id": "8003", "simple": { "limit": 20, "period": 60 } }
      ],
      "r2_buckets": [{ "binding": "DATA_BUCKET", "bucket_name": "bft-transit-data" }],
      // Intentionally no DATA service binding: staging reads R2. (Wrangler warns that the top-level DATA binding
      // is not inherited; that is the point.)
      "services": [],
      // Workers Paid (active 18 Oct 2026). Measured: a bus-indexed RT_MODES=all poll is ~150 ms p50 / ~250 ms
      // cold; 2 s caps a runaway cycle at ~8x the worst observed while leaving ample headroom.
      "limits": { "cpu_ms": 2000 },
      // Paid sizing: combined feeds (12,960 TransLink requests a day) with every mode matched, bus included (the
      // compact matcher fits two bus days in ~26 MB). The top-level config keeps the Free-safe ferry,train defaults.
      "vars": {
        "RT_MODES": "all",
        "RT_INDEX_MODES": "ferry,train,tram,bus",
        // Staging's realtime objects live under rt-staging/ so they never collide with production's rt/.
        "RT_R2_PREFIX": "rt-staging/",
        "RT_UPSTREAM": "https://gtfsrt.api.translink.com.au/api/realtime/SEQ",
        // Staging polls every 30 s (production 15 s) to halve its share of the bucket's R2 PUTs (20 Oct). Not slower:
        // the cron watchdog re-arms a hub whose last poll is over 45 s old.
        "RT_CYCLE_MS": "30000",
        // R2 layout of the realtime mode documents: unset = per-mode objects. Set "combined" (one object, ranged reads)
        // only once this release's readers are deployed, and unset it again before rolling back (HubDeps.layout).
        // RT_R2_COMPRESS likewise: unset = plain JSON documents. Set "gzip" only once this release's readers are deployed,
        // and unset it again before rolling back (HubDeps.compress).
        "CORS_ALLOW_ALL": "false",
        // Kill switch, read per request. ON in staging since 18 Oct (Brett approved; ANTHROPIC_API_KEY, TURNSTILE_SECRET and
        // IP_HASH_SALT are Worker secrets). To turn AI off instantly: set "false" and redeploy, or
        // `wrangler secret delete ANTHROPIC_API_KEY --env staging` (budgetConfig fails closed without a key).
        "AI_ENABLED": "true",
        // Brett's hard cap (18 Oct): US$10 a month, enforced by the Budget DO ledger.
        "AI_MONTHLY_BUDGET_USD": "10",
        "AI_PER_IP_DAILY": "10",
        "AI_GATEWAY": "bft",
        "CF_ACCOUNT_ID": "dde2914802079766f7671528e7cbae75"
      }
    },
    // PRODUCTION: api.brisbaneferry.com (Worker custom domain on the Cloudflare zone). Deployed from main only, after
    // the release PR (docs/architecture/cutover-runbook.md). Shares the static data in bft-transit-data with staging;
    // realtime objects use the canonical rt/ keys. AI starts OFF: Budget ledgers are per Worker, so turning prod AI on
    // means turning staging AI off, to keep one US$10 a month cap across environments.
    "production": {
      "name": "bft-api-prod",
      "workers_dev": false,
      "routes": [{ "pattern": "api.brisbaneferry.com", "custom_domain": true }],
      "version_metadata": { "binding": "CF_VERSION" },
      "triggers": { "crons": ["* * * * *"] },
      "durable_objects": {
        "bindings": [
          { "name": "RT_HUB", "class_name": "RtHub" },
          { "name": "BUDGET", "class_name": "Budget" }
        ]
      },
      "ratelimits": [
        { "name": "ASK_LIMITER", "namespace_id": "8002", "simple": { "limit": 3, "period": 60 } },
        { "name": "MCP_LIMITER", "namespace_id": "8006", "simple": { "limit": 30, "period": 60 } },
        { "name": "VERIFY_LIMITER", "namespace_id": "8004", "simple": { "limit": 20, "period": 60 } }
      ],
      "r2_buckets": [{ "binding": "DATA_BUCKET", "bucket_name": "bft-transit-data" }],
      "services": [],
      "limits": { "cpu_ms": 2000 },
      "vars": {
        "RT_MODES": "all",
        "RT_INDEX_MODES": "ferry,train,tram,bus",
        "RT_UPSTREAM": "https://gtfsrt.api.translink.com.au/api/realtime/SEQ",
        "CORS_ALLOW_ALL": "false",
        "AI_ENABLED": "false",
        "AI_MONTHLY_BUDGET_USD": "0",
        "AI_PER_IP_DAILY": "10",
        "AI_GATEWAY": "bft",
        "CF_ACCOUNT_ID": "dde2914802079766f7671528e7cbae75"
      }
    }
  }
}

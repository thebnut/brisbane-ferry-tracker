{
  "name": "@bft/edge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Edge API Worker (Hono) and the RtHub realtime Durable Object (transit-architecture.md \u00a73.3, \u00a73.8).",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "gen:proto": "sh scripts/gen-proto.sh",
    "spike": "node --expose-gc --experimental-transform-types --no-warnings scripts/spike.ts",
    "shadow-diff": "node --experimental-transform-types --no-warnings scripts/shadow-diff.ts",
    "freshness": "node --experimental-transform-types --no-warnings scripts/freshness.ts",
    "deploy:staging": "BUILD_SHA=$(node ../../scripts/build-sha.mjs) && wrangler deploy --env staging --var BUILD_SHA:$BUILD_SHA",
    "deploy:data-staging": "pnpm --filter @bft/data deploy:staging",
    "deploy:production": "BUILD_SHA=$(node ../../scripts/build-sha.mjs) && wrangler deploy --env production --var BUILD_SHA:$BUILD_SHA"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@bft/core": "workspace:*",
    "@bufbuild/protobuf": "2.16.0",
    "@leeoniya/ufuzzy": "1.0.19",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@bft/config": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@cloudflare/workers-types": "5.20261018.1",
    "@types/node": "22.20.5",
    "miniflare": "5.20261012.1-beta",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.1",
    "zod": "4.6.7"
  }
}

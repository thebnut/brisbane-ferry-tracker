VITE_GTFS_API_BASE=https://gtfsrt.api.translink.com.au/api/realtime/SEQ/

# Feedback form: Discord webhook for the feedback channel (api/feedback.js).
# The URL contains the webhook token: keep it in .env.local / Vercel env only, never commit it.
# Unset, /api/feedback answers 503.
FEEDBACK_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
